# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
# Anchored to the repo root. Unanchored, "[Bb]uild/" also matched
# Assets/_Project/Core/Scripts/Editor/Build/, which quietly kept Build_Android.cs -- the
# file that produces the Play artifact, holds the keystore paths and owns
# SHIP_SCENES -- out of version control entirely. A fresh clone could not
# build for Android and nothing said so.
/[Bb]uild/
/[Bb]uilds/
[Ll]ogs/
.utmp/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
# Per-build reports written by BuildReportInspector: GUID-named, one per build.
/[Aa]ssets/BuildReports/
# The Test Runner's temporary scene (InitTestScene<guid>.unity): left behind when a test run is interrupted.
/[Aa]ssets/InitTestScene*.unity
/[Aa]ssets/InitTestScene*.unity.meta

# Old training runs (results/<boxer>/<run>).
results/

# Asset store tools
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE
.idea/
.vs/
.vsconfig
*.csproj
*.slnx
*.sln
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt
*.stackdump

# Claude Code local settings and session state
.claude/settings.local.json
.claude/state/*.json
.claude/state/*.jsonl
.claude/state/*.txt
.claude/state/*.md

# Unity addressables / builds
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
# Play publishing tooling venv, kept apart from the training venv.
scripts/publish-venv/

# Python bytecode
__pycache__/

# Written by the Unity Performance Testing package on every batchmode run.
/[Aa]ssets/Resources/PerformanceTestRun*.json*

SmokeBuild/
SmokeBuildWalk/
WatchBuild/
shots/

# MuJoCo plugin's runtime log and trainer stderr dumps — run artifacts.
MUJOCO_LOG.TXT
Training/*.err

# PoBox trainer (Training/): checkpoints are hundreds of 5 MB files a run; the policies the game
# plays are copied to Assets/Entrants by PoBox/Import Trained Entrants. Training/logs is covered by [Ll]ogs/.
/Training/checkpoints/
# MuJoCo 3.5.0 for Python, the version Unity runs (pip install --no-deps --target): PYTHONPATH points here
# for reference runs and the exam.
/Training/.mj350/
# CMU motion-capture BVH files fetched by Training/tools/retarget_clips.py; the retargeted clips/walk_turn.npz is versioned.
/Training/clips/cmu/

# WebGL build: Burst output Unity writes beside the project
/Data/

# Generated Unity C# project files
/*.csproj
.venv/
